{
  "name": "budget-fiscal",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "desktop": "vite build && electron .",
    "desktop:dev": "ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "dist:desktop": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "zustand": "^5.1.0"
  },
  "description": "Suivi de budget, patrimoine et optimisation fiscale pour les particuliers en France.",
  "author": "Cap Budget",
  "main": "electron/main.cjs",
  "build": {
    "appId": "fr.capbudget.app",
    "productName": "Cap Budget",
    "copyright": "Cap Budget",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "Cap-Budget-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cap Budget",
      "language": "1036"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Cap Budget",
      "executableName": "cap-budget"
    }
  }
}
